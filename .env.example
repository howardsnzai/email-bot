# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- Gmail ---
# OAuth "installed app" credentials downloaded from Google Cloud Console
# (Gmail API enabled). First run opens a browser consent flow and writes token.json.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# The Howards inbox Jason works from; also the operator address.
OPERATOR_EMAIL=howardsnz.ai@gmail.com
POLL_INTERVAL_SECONDS=30

# --- Stripe ---
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VIDEO_PRICE_CENTS=19900
VIDEO_CURRENCY=nzd
VIDEO_PRODUCT_NAME=Howards AI Marketing Video

# --- Google amenity + image search ---
GOOGLE_MAPS_API_KEY=AIza...           # Geocoding + Places APIs
GOOGLE_CSE_API_KEY=AIza...            # Custom Search JSON API
GOOGLE_CSE_ID=...                     # Programmable Search Engine ID (image search enabled)

# --- Render pipeline (downstream service) ---
# If set, the assembled job package is POSTed here; otherwise it is written
# to the job folder as package.json (stub mode).
RENDER_URL=

# --- Webhook server ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# --- Storage ---
# Backend: "supabase" (default when SUPABASE_URL/SUPABASE_KEY are set) or "local".
# Apply migrations/001_memory.sql to the Supabase project first.
STORE_BACKEND=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_secret_...
# Local fallback / media staging dir (photos move to Cloudflare R2 later).
MEMORY_DIR=./memory

# --- Behaviour ---
GHOST_DAYS=7
MIN_PHOTOS=12
MIN_PHOTO_WIDTH=1024
MIN_PHOTO_HEIGHT=683
