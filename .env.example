# Secrets only. Non-secret settings (Gmail paths, poll interval, model,
# prices, webhook host/port, behaviour knobs, ...) live in config/email-bot.json.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...

# --- Stripe ---
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google amenity + image search ---
GOOGLE_MAPS_API_KEY=AIza...           # Geocoding + Places APIs
GOOGLE_CSE_API_KEY=AIza...            # Custom Search JSON API
GOOGLE_CSE_ID=...                     # Programmable Search Engine ID (image search enabled)

# --- Storage ---
# Backend: "supabase" (default when SUPABASE_URL/SUPABASE_KEY are set) or "local".
# Apply migrations/001_memory.sql to the Supabase project first.
STORE_BACKEND=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_secret_...
